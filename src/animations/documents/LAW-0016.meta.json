    "defaultMs": 8000,
    "minMs": 1000,
    "maxMs": 60000,
    "designedFor": [
      2000,
      6000,
      12000
    ]
  },
  "sizes": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "compatibility": {
