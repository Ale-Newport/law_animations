      },
      "documentTitle": {
        "type": "string",
        "maxLength": 120,
        "description": "Document title printed on the sheet (wraps to two lines, then shrinks within a bound, then ellipsis with full text kept accessible)"
      },
      "clauses": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 90,
          "description": "Clause wording",
          "minLength": 1
        },
        "minItems": 1,
        "maxItems": 4,
        "description": "Original wording of each clause (version A). The revised version (B) is derived by applying `edits`; clause rows stay aligned across both versions (array replaces the previous value)"
      },
      "signers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 60,
              "description": "Display name (fictional by default)"
            },
            "role": {
              "type": "string",
              "maxLength": 60,
              "description": "Descriptive role label (not a legal finding)"
            },
            "appearance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "skin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5,
                  "description": "Skin tone index 0–5"
                },
                "hair": {
                  "type": "string",
                  "enum": [
                    "short",
                    "long",
                    "bun",
                    "curly",
                    "buzz",
                    "scarf"
                  ],
                  "description": "Hair style"
                },
                "hairColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "Hair colour index 0–6"
                },
                "outfit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7,
                  "description": "Outfit colour index 0–7"
                },
                "glasses": {
                  "type": "boolean",
                  "description": "Wears glasses"
                }
              },
              "required": [],
              "description": "Optional appearance overrides; defaults derive from the seed"
            }
          },
          "required": [
            "name"
          ],
          "description": "A fictional person or party"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "Drafting party who brings the revised version (first) and reviewer who compares it (second) (array replaces the previous value)"
      },
      "redactions": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Clause index"
        },
        "minItems": 0,
        "maxItems": 4,
        "description": "Zero-based clause indices whose wording is withheld by redaction bars in both versions (changes inside them are not linked) (array replaces the previous value)"
      },
      "edits": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clause": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "Zero-based index of the clause that changes"
            },
            "from": {
              "type": "string",
              "maxLength": 40,
              "description": "Words of the original clause that were modified; they must appear verbatim in that clause",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "maxLength": 40,
              "description": "Replacement words in the revised version (an empty string marks a deletion)"
            }
          },
          "required": [
            "clause",
            "from",
            "to"
          ],
          "description": "One wording change between the two versions"
        },
        "minItems": 0,
        "maxItems": 4,
        "description": "Wording changes that turn the original text into the revised text. An edit whose `from` words are not found in its clause is ignored and reported in the scene state (unmatchedEdits) (array replaces the previous value)"
      },
      "focusTarget": {
        "type": "string",
        "enum": [
          "revised",
          "original"
        ],
        "description": "Detail that is enlarged and substituted"
      },
      "beforeValue": {
        "type": "string",
        "maxLength": 90,
        "description": "Value shown before the substitution"
      },
      "afterValue": {
        "type": "string",
        "maxLength": 90,
        "description": "Value shown after the substitution (the alternative datum)"
      },
      "detailGeometry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "zoom": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 4,
            "description": "Magnification of the lens"
          },
          "placement": {
            "type": "string",
            "enum": [
              "auto",
              "left",
              "right",
              "top",
              "bottom"
            ],
            "description": "Corner of the context minimap (auto = the corner that leaves the enlarged words uncovered, top right first; left / right = top corners; top = top right; bottom = bottom right)"
          }
        },
        "required": [],
        "description": "Lens geometry"
      },
      "contextLabels": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "string",
            "maxLength": 80,
            "description": "Context caption"
          },
          "marker": {
            "type": "string",
            "maxLength": 40,
            "description": "Label of the changed-datum marker"
          }
        },
        "required": [],
        "description": "Labels for the context view"
      },
      "focusEdit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3,
        "description": "Index (in `edits`) of the modified wording that is enlarged; its words on the focused sheet are the datum substituted"
      }
    }
  },
